# Core scaffold profile. Copy to .env only for local development.
APP_PROFILE=core
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
LOG_FORMAT=json

# Contest authentication is disabled for local scaffold development.
CONTEST_AUTH_MODE=none
# CONTEST_API_KEY=replace-with-organizer-provided-shared-key

# Local Raw Store. Container profiles will override this path explicitly.
DATABASE_PATH=data/memory.db
SQLITE_BUSY_TIMEOUT_MS=5000

# B04's isolated three-service Compose uses deploy/compose.env.example instead of this file.
# It requires a private NEO4J_PASSWORD and intentionally exposes no host port.
