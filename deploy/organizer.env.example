# MemScope organizer runtime profile.
# Copy this file outside the extracted ZIP, chmod 0600, then replace secret placeholders only.

NEO4J_PASSWORD=replace-with-a-random-secret-at-least-8-characters

# Huawei organizer gateway facts supplied for B10. Both clients use OpenAI-compatible Bearer auth.
MEMSCOPE_MODEL_PROFILE=gateway
MEMSCOPE_ALLOW_INSECURE_MODEL_HTTP=true
MEMRADER_MODEL=GLM-V5_1-DX
MEMRADER_API_BASE=http://aigateway.huawei.com/v1
MEMRADER_API_KEY=replace-with-private-bearer-api-key
MOS_EMBEDDER_MODEL=bge-m3
MOS_EMBEDDER_API_BASE=http://aigateway.huawei.com/v1
MOS_EMBEDDER_API_KEY=replace-with-private-bearer-api-key
EMBEDDING_DIMENSION=1024

# Public contest service. Leave auth disabled unless the organizer requires an inbound shared key.
MEMSCOPE_PUBLIC_PORT=8080
CONTEST_AUTH_MODE=none
# CONTEST_API_KEY=replace-with-organizer-provided-private-key

# B05/B06 frozen request budgets and conservative Search baseline.
ADD_DEADLINE_SECONDS=115
ADD_WARN_SECONDS=105
MEMOS_DEADLINE_RESERVE_SECONDS=5
MEMOS_CONNECT_TIMEOUT_SECONDS=3
MEMOS_RESPONSE_MAX_BYTES=1048576
MEMRADER_TIMEOUT_SECONDS=110
MEM_READER_CHAT_WINDOW_MAX_TOKENS=1024
MEM_READER_REMOVE_PROMPT_EXAMPLE=false
SEARCH_DEADLINE_SECONDS=55
SEARCH_WARN_SECONDS=50
MEMOS_SEARCH_MODE=fast
MEMOS_SEARCH_RELATIVITY=0.0
MEMOS_SEARCH_DEDUP=exact
MEMOS_SEARCH_RERANK=true

# The released baseline uses in-process cosine reranking. The separately advertised
# /v1/reranker endpoint is not used until its exact request/response contract is tested.

# Optional resource ceilings. Defaults total 8.5 GiB; use a host with at least 10 GiB RAM.
# MEMORY_API_MEMORY_LIMIT=512m
# MEMORY_API_CPU_LIMIT=1.0
# MEMOS_MEMORY_LIMIT=4g
# MEMOS_CPU_LIMIT=4.0
# NEO4J_MEMORY_LIMIT=2g
# NEO4J_CPU_LIMIT=2.0
# QDRANT_MEMORY_LIMIT=2g
# QDRANT_CPU_LIMIT=2.0
