# Development-machine profile for the B10 Gate 2 external API baseline.
# Copy this file outside the repository with mode 0600 and replace secrets locally.
NEO4J_PASSWORD=replace-with-a-random-secret
MEMSCOPE_MODEL_PROFILE=gateway
MEMSCOPE_ALLOW_INSECURE_MODEL_HTTP=false

# Zhipu general API. Do not substitute a Coding Plan key or endpoint.
MEMRADER_MODEL=glm-5.1
MEMRADER_API_BASE=https://open.bigmodel.cn/api/paas/v4
MEMRADER_API_KEY=replace-with-private-key
MEMRADER_MAX_TOKENS=8000
MEMRADER_TIMEOUT_SECONDS=110
MEMRADER_THINKING_TYPE=disabled
MEMRADER_RESPONSE_FORMAT=json_object

# SiliconFlow BGE-M3 returns 1024 dimensions but rejects the dimensions request field.
MOS_EMBEDDER_MODEL=BAAI/bge-m3
MOS_EMBEDDER_API_BASE=https://api.siliconflow.cn/v1
MOS_EMBEDDER_API_KEY=replace-with-private-key
MOS_EMBEDDER_TIMEOUT=10
MOS_EMBEDDER_SEND_DIMENSIONS=false
EMBEDDING_DIMENSION=1024

# The approved baseline remains local cosine reranking.
MOS_RERANKER_BACKEND=cosine_local
MOS_FEEDBACK_RERANKER_BACKEND=cosine_local

# Optional external reranker settings. Uncomment only for an approved isolated smoke test.
# MOS_RERANKER_URL=https://api.siliconflow.cn/v1/rerank
# MOS_RERANKER_API_KEY=replace-with-private-key
# MOS_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# MOS_FEEDBACK_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# MOS_RERANKER_TIMEOUT_SECONDS=10
# MOS_RERANKER_MAX_RETRIES=1
# MOS_RERANKER_RETRY_BACKOFF_SECONDS=0.25

# Existing bounded Add/Search defaults.
MEM_READER_CHAT_WINDOW_MAX_TOKENS=1024
MEM_READER_REMOVE_PROMPT_EXAMPLE=false
MEMSCOPE_PUBLIC_PORT=8080
ADD_DEADLINE_SECONDS=115
ADD_WARN_SECONDS=105
MEMOS_DEADLINE_RESERVE_SECONDS=5
MEMOS_CONNECT_TIMEOUT_SECONDS=3
MEMOS_RESPONSE_MAX_BYTES=1048576
SEARCH_DEADLINE_SECONDS=55
SEARCH_WARN_SECONDS=50
MEMOS_SEARCH_MODE=fast
MEMOS_SEARCH_RELATIVITY=0.0
MEMOS_SEARCH_DEDUP=exact
MEMOS_SEARCH_RERANK=true

# Development build inputs.
MEMSCOPE_PIP_INDEX_URL=https://pypi.org/simple
MEMSCOPE_SOURCE_REVISION=development
