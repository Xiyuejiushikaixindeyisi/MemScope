# Copy to a private temporary file or let scripts/verify_b04_runtime.py generate one.
# Never commit the real value. At least eight characters are required by Neo4j.
NEO4J_PASSWORD=replace-with-a-random-secret

# Huawei laboratory gateway profile. Replace only the secret placeholders locally; they are
# rejected by the deployment script and must never be committed.
MEMSCOPE_MODEL_PROFILE=gateway
MEMSCOPE_ALLOW_INSECURE_MODEL_HTTP=true
MEMRADER_MODEL=GLM-V5_1-DX
MEMRADER_API_BASE=http://aigateway.huawei.com/v1
MEMRADER_API_KEY=replace-with-private-key
MOS_EMBEDDER_MODEL=bge-m3
MOS_EMBEDDER_API_BASE=http://aigateway.huawei.com/v1
MOS_EMBEDDER_API_KEY=replace-with-private-key
EMBEDDING_DIMENSION=1024

# Public Adapter and bounded Add execution.
MEMSCOPE_PUBLIC_PORT=8080
ADD_DEADLINE_SECONDS=115
ADD_WARN_SECONDS=105
MEMOS_DEADLINE_RESERVE_SECONDS=5
MEMOS_CONNECT_TIMEOUT_SECONDS=3
MEMOS_RESPONSE_MAX_BYTES=1048576
MEMRADER_TIMEOUT_SECONDS=110
MEM_READER_CHAT_WINDOW_MAX_TOKENS=1024
MEM_READER_REMOVE_PROMPT_EXAMPLE=false

# B06 conservative Product Search baseline. These are runtime settings and do not require rebuilds.
SEARCH_DEADLINE_SECONDS=55
SEARCH_WARN_SECONDS=50
MEMOS_SEARCH_MODE=fast
MEMOS_SEARCH_RELATIVITY=0.0
MEMOS_SEARCH_DEDUP=exact
MEMOS_SEARCH_RERANK=true
# The current implementation uses the local cosine reranker. The Huawei /v1/reranker endpoint is
# intentionally not configured until a separate adapter is approved and tested.

# Internal build-only Python package indexes used by the Docker builders.
B04_PIP_INDEX_URL=https://cmc.centralrepo.rnd.huawei.com/artifactory/pypi-center/
B04_PIP_EXTRA_INDEX_URL=https://cmc.centralrepo.rnd.huawei.com/artifactory/pypi-central-repo/simple/ https://cmc.centralrepo.rnd.huawei.com/artifactory/product_pypi/simple/
B04_PIP_TRUSTED_HOST=cmc.centralrepo.rnd.huawei.com

# Optional resource ceilings. Defaults are safe for a host with at least 8 GiB RAM.
# B04_MEMOS_MEMORY_LIMIT=4g
# B04_MEMOS_CPU_LIMIT=4.0
# B04_NEO4J_MEMORY_LIMIT=2g
# B04_NEO4J_CPU_LIMIT=2.0
# B04_QDRANT_MEMORY_LIMIT=2g
# B04_QDRANT_CPU_LIMIT=2.0
