# Copy to a private temporary file or let scripts/verify_b04_runtime.py generate one.
# Never commit the real value. At least eight characters are required by Neo4j.
NEO4J_PASSWORD=replace-with-a-random-secret

# B04-only bootstrap dimension. No embedding request is made in B04.
# B05 must replace this with the selected embedding model's actual fixed dimension and
# recreate the B04 test volumes if that value changes.
B04_BOOTSTRAP_EMBEDDING_DIMENSION=16

# Optional build-only mirror. Leave unset to use the official PyPI endpoint.
# This is useful when the official endpoint is slow or unavailable locally.
# B04_PIP_INDEX_URL=https://repo.huaweicloud.com/repository/pypi/simple

# Optional resource ceilings. Defaults are safe for a host with at least 8 GiB RAM.
# B04_MEMOS_MEMORY_LIMIT=4g
# B04_MEMOS_CPU_LIMIT=4.0
# B04_NEO4J_MEMORY_LIMIT=2g
# B04_NEO4J_CPU_LIMIT=2.0
# B04_QDRANT_MEMORY_LIMIT=2g
# B04_QDRANT_CPU_LIMIT=2.0
